{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adstorybook/videoexpress/schemas/qa-report.schema.json",
  "title": "VideoExpress render quality report",
  "type": "object",
  "required": ["report_id", "render_id", "created_at", "checks", "overall_status", "full_watch_completed", "approval"],
  "properties": {
    "report_id": {"type": "string"},
    "project_id": {"type": "string"},
    "render_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "reviewer": {"type": "string"},
    "checks": {"type": "array", "items": {"type": "object", "required": ["check_id", "result", "notes"], "properties": {"check_id": {"type": "string"}, "result": {"type": "string", "enum": ["pass", "fail", "warning", "not_checked"]}, "notes": {"type": "string"}, "timecode": {"type": ["string", "null"]}, "evidence_ref": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "overall_status": {"type": "string", "enum": ["pass", "fail", "needs_changes", "incomplete"]},
    "full_watch_completed": {"type": "boolean"},
    "approval": {"type": "object", "required": ["approved", "approved_by"], "properties": {"approved": {"type": "boolean"}, "approved_by": {"type": ["string", "null"]}, "approved_at": {"type": ["string", "null"], "format": "date-time"}, "notes": {"type": "string"}}, "additionalProperties": false},
    "export": {"type": ["object", "null"], "properties": {"container": {"type": "string"}, "codec": {"type": "string"}, "resolution": {"type": "string"}, "aspect_ratio": {"type": "string"}, "frame_rate": {"type": "number"}, "duration_seconds": {"type": "number"}, "file_ref": {"type": ["string", "null"]}, "checksum": {"type": ["string", "null"]}}, "additionalProperties": true}
  },
  "additionalProperties": false
}
